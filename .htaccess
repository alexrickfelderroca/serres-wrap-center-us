# ─────────────────────────────────────────────────────────────────────────────
#  SERRES Wrap Center (US) — Apache config for Hostinger
#
#  Ignored by GitHub Pages (that is nginx), so keeping this file costs nothing
#  there and the repo stays deployable to both.
#
#  Replaces the Barcelona site's version, which set
#      Cache-Control: no-cache, no-store, must-revalidate, max-age=0
#  on every HTML response. "no-store" forbids the browser from keeping the file
#  AT ALL, so every repeat visit re-downloaded the page — the opposite of what
#  the spec's Core Web Vitals gate (§11) needs. The goal there was "edits show
#  up immediately", which "no-cache" already achieves: the browser may store the
#  file but must revalidate before reusing it, and an unchanged file comes back
#  as a tiny 304.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. HTTPS, and one canonical host ────────────────────────────────────────
# The site's canonical tags all point at the apex (https://serreswrap.com), so
# www redirects to apex. Pick one and never both (spec §8.4).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # force HTTPS (Hostinger terminates TLS upstream, so trust the forwarded header)
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # www → apex
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ── 2. Directory routes ─────────────────────────────────────────────────────
# Every page ships as <route>/index.html, which Apache serves natively.
# Trailing-slash consistency is handled by mod_dir; no rewrite rules needed.
DirectoryIndex index.html
Options -Indexes

# ── 2b. Retired URLs ────────────────────────────────────────────────────────
# Ceramic coating was withdrawn as a service on 2026-09-17. Both of these were
# indexed and linked, so they get a 301 rather than a 404: the service page to
# the home page, since no other service replaces it, and the article to the blog
# index, which still carries its three siblings.
#
# This block sits BEFORE ErrorDocument on purpose — a 301 has to win over the 404.
# And it is live: this site is served by Hostinger (Apache), not GitHub Pages, so
# unlike the note at the top of this file these rules actually run.
RedirectMatch 301 ^/ceramic-coating/?$ /
RedirectMatch 301 ^/blog/ppf-vs-ceramic-coating/?$ /blog/

# ── 3. Custom 404 ───────────────────────────────────────────────────────────
# Root-relative, so it resolves whatever folder the missing URL pretended to be
# in. 404.html itself uses depth-0 paths for exactly this reason.
ErrorDocument 404 /404.html

# ── 4. Caching ──────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
  Header unset Pragma
  Header unset Expires

  # HTML: store it, but always check with the server first. Content changes on
  # every deploy and filenames never do, so it must never be reused blind.
  <FilesMatch "\.(html?|xml|json|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS / JS: same reasoning — the filenames are stable but the bytes change
  # with each build, so revalidate rather than serve a stale stylesheet.
  <FilesMatch "\.(css|js|mjs)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Images, fonts, video: the CONTENT behind a given filename does not change —
  # a new photo gets a new name. Safe to cache hard, and this is where the
  # repeat-visit performance actually comes from.
  <FilesMatch "\.(jpe?g|png|webp|avif|gif|svg|ico|mp4|webm|woff2?|ttf)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>
</IfModule>

# ETag + Last-Modified are what make the revalidation above cheap (304s).
FileETag MTime Size

# ── 5. Compression ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  # already-compressed formats gain nothing and cost CPU
  SetEnvIfNoCase Request_URI \.(?:woff2?|png|jpe?g|webp|avif|gif|mp4|webm|ico)$ no-gzip dont-vary
</IfModule>

# ── 6. MIME types ───────────────────────────────────────────────────────────
# Some Hostinger Apache builds do not know woff2 and serve it as octet-stream,
# which makes the browser refuse the font and fall back to a system face.
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType font/woff  .woff
  AddType font/ttf   .ttf
  AddType image/webp .webp
  AddType image/avif .avif
  AddType video/webm .webm
  AddType video/mp4  .mp4
  AddType application/manifest+json .webmanifest
</IfModule>

# ── 7. Security headers ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # HSTS: only switch this on once HTTPS is confirmed working on the real domain,
  # otherwise a misconfigured cert locks visitors out for a year.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── 8. Keep everything that is not the website off the web ──────────────────
# Deployment is a Git import of the whole repo, so the build tooling and the
# internal documents land on the server too. None of them may be reachable.
#
#   _build/   Node scripts and ~9k lines of recon notes
#   .git/     full history, including every commit message
#   *.md      CLAUDE.md, README.md, and in particular TODO.md (which lists what
#             is unverified and that the legal pages are not lawyer-reviewed) and
#             SERRES-US-WEBSITE-SPEC_1.md (the client's brief, deadlines and
#             commercial strategy). Publishing those would be a real leak.
RedirectMatch 404 ^/_build(/|$)
RedirectMatch 404 ^/\.git(/|$)
RedirectMatch 404 ^/\.screenshots(/|$)
RedirectMatch 404 ^/\.github(/|$)

<FilesMatch "\.(md|bak|log|sh|ps1)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(\.gitignore|\.gitattributes|\.env.*|package.*\.json)$">
  Require all denied
</FilesMatch>

# Apache 2.2 fallback for the same two blocks
<IfModule !mod_authz_core.c>
  <FilesMatch "\.(md|bak|log|sh|ps1)$">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>
